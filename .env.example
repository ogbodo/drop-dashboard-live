# Copy to .env for local development. Local work uses the DEV project.
#
# Branch -> deployment -> backend
#   dev branch   ->  Vercel Preview     ->  dev  project  bvrfhqllbvqkocfkduhy
#   main branch  ->  Vercel Production  ->  prod project  wumhtdhmntjvicsiiovu
#
# These are NEXT_PUBLIC_*, so they are baked in at build time. Set them per
# environment in Vercel (Project -> Settings -> Environment Variables), choosing
# Production for the prod values and Preview + Development for the dev values.
# Changing them requires a redeploy to take effect.
#
# The drop-admin edge function is deployed by CI from a single
# SUPABASE_ACCESS_TOKEN repository secret (account-scoped, covers both projects).
#
# lib/env.ts refuses to start a Preview deployment that points at the prod
# project, and warns when a Production deployment points at dev. See
# assertBackendMatchesDeployment().

# ---- dev project (local, and Vercel Preview / Development) ----
NEXT_PUBLIC_SUPABASE_URL=https://bvrfhqllbvqkocfkduhy.supabase.co
NEXT_PUBLIC_SUPABASE_FUNCTION_URL=https://bvrfhqllbvqkocfkduhy.functions.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DASHBOARD_FUNCTION_NAME=drop-admin

# ---- prod project (Vercel Production only) ----
# NEXT_PUBLIC_SUPABASE_URL=https://wumhtdhmntjvicsiiovu.supabase.co
# NEXT_PUBLIC_SUPABASE_FUNCTION_URL=https://wumhtdhmntjvicsiiovu.functions.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_DASHBOARD_FUNCTION_NAME=drop-admin

# Escape hatch for the guard above — e.g. to inspect prod data from a preview
# deploy on purpose. Leave unset normally.
# DASHBOARD_ALLOW_BACKEND_MISMATCH=true
