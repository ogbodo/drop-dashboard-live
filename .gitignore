.next
node_modules

# env files — only the .example template is tracked
.env
.env.*
!.env.example
supabase/functions.env
supabase/functions.*.env
supabase/deploy.env
supabase/deploy.*.env

# Supabase CLI local cache — machine-specific, rewritten on every CLI invocation.
# supabase/.temp/cli-latest was tracked, so it showed up as a modification for
# whoever last ran the CLI. Matches the drop-backend repo, which already ignores it.
supabase/.temp/
npm-debug.log*
.DS_Store
**/.DS_Store
supabase/wipe_app_data_keep_config.sql
supabase/verify_wipe_app_data_keep_config.sql

# test artifacts
coverage/
test-results/
playwright-report/

# TypeScript incremental build cache — regenerated by tsc/next build.
*.tsbuildinfo
